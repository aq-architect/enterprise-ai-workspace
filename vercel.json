{
  "version": 2,
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist/apps/client/browser",
  "framework": null,
  "functions": {
    "api/health.ts": { "memory": 256, "maxDuration": 10 },
    "api/docs.ts": { "memory": 256, "maxDuration": 10 },
    "api/gateway.ts": { "memory": 256, "maxDuration": 30 },
    "api/agent.ts": { "memory": 256, "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/docs", "destination": "/api/docs" },
    { "source": "/api/agent/docs", "destination": "/api/docs" },
    { "source": "/api/v1/agent/chat", "destination": "/api/agent" },
    { "source": "/api/v1/gateway/dispatch", "destination": "/api/gateway" },
    { "source": "/api/v1/gateway/agent/dispatch", "destination": "/api/gateway" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
