{
  "name": "ai-cli-agent",
  "version": "1.0.2",
  "description": "Developer CLI and shared toolkit for the Enterprise AI Workspace (Angular studio, NestJS gateway, LangGraph agent-core). Local ping/gateway helpers only — LLM keys stay in agent-core, not in this CLI.",
  "license": "MIT",
  "main": "./index.js",
  "types": "./index.d.ts",
  "bin": {
    "ai-cli": "./bin/ai-cli.js"
  },
  "files": [
    "**/*"
  ],
  "scripts": {
    "prepublishOnly": "node -e \"require('fs').accessSync('./index.js')\""
