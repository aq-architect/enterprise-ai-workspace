    "rag",
    "multi-agent",
    "openai",
    "developer-tools"
  ],
  "dependencies": {
    "commander": "^12.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aq-architect/enterprise-ai-workspace.git",
    "directory": "libs/ai-cli"
  },
